{
    "type": "AdaptiveCard",
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.5",
    "body": [
        {
            "type": "ColumnSet",
            "columns": [
                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {
                            "type": "TextBlock",
                            "text": "${providerName} Data",
                            "weight": "bolder",
                            "size": "medium",
                            "color": "${textColor}",
                            "wrap": true
                        }
                    ],
                    "verticalContentAlignment": "center"
                },
                {
                    "type": "Column",
                    "width": "auto",
                    "items": [
                        {
                            "type": "TextBlock",
                            "text": "${remainingText}",
                            "weight": "bolder",
                            "size": "medium",
                            "color": "${statusColor}",
                            "horizontalAlignment": "right"
                        }
                    ],
                    "verticalContentAlignment": "center"
                }
            ]
        },
        {
            "type": "TextBlock",
            "text": "${usedText}",
            "size": "small",
            "color": "${textColor}",
            "spacing": "small",
            "wrap": true
        },
        {
            "type": "TextBlock",
            "text": "${resetTime}",
            "size": "small",
            "weight": "lighter",
            "color": "${textColor}",
            "isSubtle": true,
            "spacing": "none"
        },
        {
            "type": "TextBlock",
            "text": "${connection}",
            "$when": "${connection != ''}",
            "size": "small",
            "weight": "lighter",
            "color": "${textColor}",
            "isSubtle": true,
            "spacing": "none"
        },
        {
            "type": "ColumnSet",
            "spacing": "small",
            "columns": [
                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {
                            "type": "ColumnSet",
                            "spacing": "none",
                            "columns": [
                                { "type": "Column", "width": "${percentValueClamped}", "items": [], "minHeight": "4px", "backgroundImage": { "url": "${barFill}", "fillMode": "repeat" } },
                                { "type": "Column", "width": "${percentRemaining}", "items": [], "minHeight": "4px", "backgroundImage": { "url": "${barTrack}", "fillMode": "repeat" } }
                            ]
                        }
                    ],
                    "verticalContentAlignment": "center"
                },
                {
                    "type": "Column",
                    "width": "auto",
                    "items": [
                        {
                            "type": "TextBlock",
                            "text": "${percentText} used",
                            "size": "small",
                            "weight": "lighter",
                            "color": "${statusColor}"
                        }
                    ],
                    "verticalContentAlignment": "center"
                },
                {
                    "type": "Column",
                    "width": "auto",
                    "spacing": "small",
                    "selectAction": { "type": "Action.Execute", "verb": "refresh", "tooltip": "Refresh now" },
                    "items": [
                        {
                            "type": "TextBlock",
                            "text": "⟳",
                            "size": "small",
                            "weight": "lighter",
                            "color": "${textColor}",
                            "isSubtle": true
                        }
                    ],
                    "verticalContentAlignment": "center"
                }
            ]
        },
        {
            "type": "TextBlock",
            "text": "${statusMessage}",
            "$when": "${statusMessage != ''}",
            "size": "small",
            "color": "${messageColor}",
            "isSubtle": "${messageSubtle}",
            "wrap": true,
            "spacing": "small"
        },
        {
            "type": "ActionSet",
            "$when": "${needsReconnect}",
            "spacing": "small",
            "actions": [
                { "type": "Action.Execute", "verb": "reconnect", "title": "Reconnect" }
            ]
        }
    ],
    "backgroundImage": {
        "url": "${background}",
        "fillMode": "repeatVertically"
    }
}
