<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows SDK TFM (not plain net8.0-windows) so the collector can call
         NetworkDetector, which uses Windows.Networking.Connectivity to skip
         scraping when we're not tethered. -->
    <TargetFramework>net8.0-windows10.0.22621</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.49.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MobileData.Core\MobileData.Core.csproj" />
    <ProjectReference Include="..\MobileData.Providers\MobileData.Providers.csproj" />
  </ItemGroup>
</Project>
